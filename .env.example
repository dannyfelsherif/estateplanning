# Copy to .env and fill in real values. Never commit .env.

# Anthropic API key used for summarization, drafting, and risk analysis.
# If left blank, the app runs in MOCK_LLM mode: it still works end-to-end,
# but every generated summary/draft/risk-flag is a clearly labeled stub
# so you can demo the workflow without spending API credits or handling
# real client data before you're ready.
ANTHROPIC_API_KEY=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

# Model used for all LLM calls.
ANTHROPIC_MODEL=claude-sonnet-5

# Long random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-long-random-value

# SQLite database file path.
DATABASE_URL=sqlite:///./data/estate.db

# Directory for uploaded document storage.
UPLOAD_DIR=./data/uploads

# Seed attorney account created on first run if no users exist.
ADMIN_EMAIL=attorney@example.com
ADMIN_PASSWORD=change-me-immediately
ADMIN_NAME=Firm Attorney
